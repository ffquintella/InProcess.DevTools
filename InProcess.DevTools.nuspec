<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>InProcess.DevTools</id>
    <version>12.0.2</version>
    <authors>Felipe Quintella</authors>
    <owners>Felipe Quintella</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/ffquintella/InProcess.DevTools</projectUrl>
    <description>InProcess.DevTools - Avalonia 12+ compatible DevTools fork. Provides in-process developer tools for inspecting visual tree, styles, and properties.</description>
    <releaseNotes>https://github.com/ffquintella/InProcess.DevTools/releases</releaseNotes>
    <copyright>Copyright 2026-2026 Felipe Quintella</copyright>
    <tags>avalonia devtools diagnostics debugging inspector</tags>
    <readme>README.md</readme>
    <icon>Icon.png</icon>
    <repository type="git" url="https://github.com/ffquintella/InProcess.DevTools" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Avalonia" version="11.1.0" exclude="Build,Analyzers" />
        <dependency id="Avalonia.Themes.Simple" version="11.1.0" exclude="Build,Analyzers" />
        <dependency id="Avalonia.Controls.ColorPicker" version="11.1.0" exclude="Build,Analyzers" />
        <dependency id="Avalonia.Controls.DataGrid" version="11.1.0" exclude="Build,Analyzers" />
        <dependency id="System.Reactive" version="6.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="src/InProcess.DevTools/bin/Release/net10.0/Avalonia.Diagnostics.dll" target="lib/net10.0" />
    <file src="README.md" target="/" />
    <file src="build/Assets/Icon.png" target="/" />
  </files>
</package>
