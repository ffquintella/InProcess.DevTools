<Project DefaultTargets="Build" 
  xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <Product>InProcess.DevTools</Product>
    <Version>12.0.2$(CIVersionSuffix)</Version>
    <Authors>Felipe Quintella</Authors>
    <Copyright>Copyright 2026-$([System.DateTime]::Now.ToString(`yyyy`)) &#169; Felipe Quintella</Copyright>
    <PackageProjectUrl>https://github.com/ffquintella/InProcess.DevTools</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ffquintella/InProcess.DevTools</RepositoryUrl>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageDescription>InProcess.DevTools - Avalonia 12+ compatible DevTools fork. Provides in-process developer tools for inspecting visual tree, styles, and properties.</PackageDescription>
    <PackageTags>avalonia;devtools;diagnostics;debugging;inspector</PackageTags>
    <PackageReleaseNotes>https://github.com/ffquintella/InProcess.DevTools/releases</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)/avalonia.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)/../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)/Assets/Icon.png" Pack="true" PackagePath="/" Visible="false"/>
  </ItemGroup>

</Project>
